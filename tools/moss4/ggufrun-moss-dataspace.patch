+// ---------------------------------------------------------------------------
+// GGUFRun patch: data-space few-step sampler (MOSS-Image DMD checkpoints such as
+// akhaliq/MOSS-Image-SFT-4-steps and lodestones/MOSS-Image-SFT-8-steps-dmd).
+//
+// Reference loop (model card):
+//   z  = randn(latent);  x0 = 0
+//   for r in steps: x = z + einsum("oc,bchw->bohw", Q, x0)
+//                   v = transformer(x, step_codes[r]);  x0 = z - v
+// The noise z is held fixed for the whole run; only the data-space estimate x0 is fed
+// back through the learned channel mix Q.  Enabled per request with
+//   extra_sample_args: "dataspace=<path to dataspace.safetensors>"
+// ---------------------------------------------------------------------------
+namespace {
+
+struct DataspaceParams {
+    std::vector<float> Q;      // [C, C] row-major, Q[o * C + c]
+    std::vector<float> codes;  // timestep codes, 0..1000 scale
+    int64_t channels = 0;
+};
+
+static bool read_safetensors_f32(const nlohmann::json& header,
+                                 const std::string& blob,
+                                 const std::string& name,
+                                 std::vector<float>* out,
+                                 std::vector<int64_t>* shape) {
+    if (!header.contains(name)) {
+        LOG_ERROR("dataspace: tensor '%s' missing", name.c_str());
+        return false;
+    }
+    const auto& info  = header[name];
+    std::string dtype = info.value("dtype", "");
+    auto offsets      = info["data_offsets"].get<std::vector<uint64_t>>();
+    *shape            = info["shape"].get<std::vector<int64_t>>();
+    if (offsets.size() != 2 || offsets[1] < offsets[0] || offsets[1] > blob.size()) {
+        LOG_ERROR("dataspace: bad data_offsets for '%s'", name.c_str());
+        return false;
+    }
+    const char* src = blob.data() + offsets[0];
+    size_t bytes    = static_cast<size_t>(offsets[1] - offsets[0]);
+    out->clear();
+    if (dtype == "F32") {
+        out->resize(bytes / 4);
+        std::memcpy(out->data(), src, out->size() * 4);
+    } else if (dtype == "F64") {
+        out->resize(bytes / 8);
+        for (size_t i = 0; i < out->size(); ++i) {
+            double v;
+            std::memcpy(&v, src + i * 8, 8);
+            (*out)[i] = static_cast<float>(v);
+        }
+    } else if (dtype == "BF16") {
+        out->resize(bytes / 2);
+        for (size_t i = 0; i < out->size(); ++i) {
+            uint16_t h;
+            std::memcpy(&h, src + i * 2, 2);
+            uint32_t bits = static_cast<uint32_t>(h) << 16;
+            float v;
+            std::memcpy(&v, &bits, 4);
+            (*out)[i] = v;
+        }
+    } else {
+        LOG_ERROR("dataspace: unsupported dtype %s for '%s'", dtype.c_str(), name.c_str());
+        return false;
+    }
+    return true;
+}
+
+static bool load_dataspace_params(const std::string& path, DataspaceParams* params) {
+    static std::mutex cache_mutex;
+    static std::string cached_path;
+    static DataspaceParams cached;
+    std::lock_guard<std::mutex> lock(cache_mutex);
+    if (!cached_path.empty() && cached_path == path) {
+        *params = cached;
+        return true;
+    }
+    std::ifstream file(std::filesystem::u8path(path), std::ios::binary);
+    if (!file) {
+        LOG_ERROR("dataspace: cannot open '%s'", path.c_str());
+        return false;
+    }
+    uint64_t header_size = 0;
+    file.read(reinterpret_cast<char*>(&header_size), 8);
+    if (!file || header_size == 0 || header_size > (64ull << 20)) {
+        LOG_ERROR("dataspace: '%s' is not a safetensors file", path.c_str());
+        return false;
+    }
+    std::string header_text(static_cast<size_t>(header_size), '\0');
+    file.read(header_text.data(), static_cast<std::streamsize>(header_size));
+    std::string blob((std::istreambuf_iterator<char>(file)), std::istreambuf_iterator<char>());
+    nlohmann::json header;
+    try {
+        header = nlohmann::json::parse(header_text);
+    } catch (const std::exception& e) {
+        LOG_ERROR("dataspace: header parse failed: %s", e.what());
+        return false;
+    }
+    DataspaceParams loaded;
+    std::vector<int64_t> q_shape, c_shape;
+    try {
+        if (!read_safetensors_f32(header, blob, "latent_mix.Q", &loaded.Q, &q_shape) ||
+            !read_safetensors_f32(header, blob, "step_codes", &loaded.codes, &c_shape)) {
+            return false;
+        }
+    } catch (const std::exception& e) {
+        LOG_ERROR("dataspace: bad tensor entry: %s", e.what());
+        return false;
+    }
+    if (q_shape.size() != 2 || q_shape[0] != q_shape[1] || static_cast<int64_t>(loaded.Q.size()) != q_shape[0] * q_shape[1]) {
+        LOG_ERROR("dataspace: latent_mix.Q must be square");
+        return false;
+    }
+    if (loaded.codes.empty()) {
+        LOG_ERROR("dataspace: step_codes is empty");
+        return false;
+    }
+    loaded.channels = q_shape[0];
+    cached          = loaded;
+    cached_path     = path;
+    *params         = std::move(loaded);
+    return true;
+}
+
+static std::string find_dataspace_arg(const char* extra_sample_args) {
+    if (extra_sample_args == nullptr || extra_sample_args[0] == '\0') {
+        return "";
+    }
+    for (const auto& [key, value] : parse_key_value_args(extra_sample_args, "sample arg")) {
+        if (key == "dataspace" || key == "moss_dataspace") {
+            std::string v = value;
+            if (v.size() >= 2 && (v.front() == '"' || v.front() == '\'') && v.back() == v.front()) {
+                v = v.substr(1, v.size() - 2);
+            }
+            return v;
+        }
+    }
+    return "";
+}
